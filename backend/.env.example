# Backend dev environment.
# Copy to .env, fill in API keys, or just run `./scripts/start-dev.sh`
# from the repo root and it will generate this file interactively.

APP_ENV=development
APP_PORT=8000

# Postgres + pgvector (required). The dev script creates the DB +
# extension automatically.
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/ecs_estimator

# Storage root for uploaded files (relative to backend/)
STORAGE_ROOT=./data/uploads

# Auth — single dev user
DEV_USER_EMAIL=admin@ecs.local
DEV_USER_PASSWORD=admin
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# CORS — frontend origin
CORS_ORIGINS=http://localhost:3000

# Upload limits
MAX_UPLOAD_MB=200

# ---------------------------------------------------------------------------
# Anthropic — required for classification, vision pre-pass, scope extraction,
# link judge, conflict arbitration, and the RAGAS judge.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5
VISION_MODEL=claude-sonnet-4-6
VISION_PROVIDER=anthropic
VISION_CONCURRENCY=5
VISION_MAX_RETRIES=2

# PDF rendering
PAGE_DPI=150
THUMBNAIL_MAX_DIM=320

# ---------------------------------------------------------------------------
# Voyage AI — required for chunk embeddings (voyage-3-large, 1024d)
# ---------------------------------------------------------------------------
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-large
INDEX_CONCURRENCY=10
CONTEXTUALIZER_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------------------
# Cohere — required for re-ranking the retrieved chunks before extraction
# ---------------------------------------------------------------------------
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5

# ---------------------------------------------------------------------------
# OCR providers — Mistral OCR + Gemini run in parallel; longest non-empty
# output wins. Both are recommended; if only one is set the ensemble runs
# single-provider.
# ---------------------------------------------------------------------------
MISTRAL_API_KEY=
GOOGLE_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-pro
