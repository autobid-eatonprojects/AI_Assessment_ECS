# Backend dev environment
APP_ENV=development
APP_PORT=8000

# SQLite for now; swap to postgresql+asyncpg://... when scaling out
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Storage root for uploaded files (relative to backend/)
STORAGE_ROOT=./data/uploads

# Auth — single dev user
DEV_USER_EMAIL=admin@ecs.local
DEV_USER_PASSWORD=admin
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# CORS — frontend origin
CORS_ORIGINS=http://localhost:3000

# Upload limits
MAX_UPLOAD_MB=200

# Anthropic (Phase 1+) — leave empty to disable classification + vision pre-pass
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-haiku-4-5

# Vision pre-pass (Phase 2)
VISION_MODEL=claude-sonnet-4-6
VISION_CONCURRENCY=5
VISION_MAX_RETRIES=2

# PDF rendering
PAGE_DPI=150
THUMBNAIL_MAX_DIM=320

# Phase 3 — Indexing + Retrieval
# Leave keys empty to disable Phase 3 indexing.
OPENAI_API_KEY=
EMBEDDING_MODEL=embed-v4.0
EMBEDDING_DIM=1536

# Cohere Rerank 3 is optional — falls back to Claude Haiku as cross-encoder.
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5

CONTEXTUALIZER_MODEL=claude-haiku-4-5
INDEX_CONCURRENCY=10
